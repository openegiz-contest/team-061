# Стенд рудника «Кенташ»: статика интерфейса и прокси к Ditto (пароль платформы подставляется на сервере,
# в браузер не попадает). Поток событий Ditto (SSE) проходит без буферизации.
server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;
  location /ditto/ {
    proxy_pass http://ditto-nginx:80/;
    proxy_http_version 1.1;
    proxy_set_header Authorization "Basic ${DITTO_BASIC_AUTH}";
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    add_header Cache-Control no-store;
  }
  location ~* \.(js|css|html)$ { add_header Cache-Control no-cache; }
}
